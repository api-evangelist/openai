  "info": {
    "_postman_id": "11a0f222-77a5-4ffd-95f1-224dd20821e7",
    "name": "OpenAI Embeddings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Get a vector representation of a given input that can be easily consumed by machine learning models and algorithms. OpenAI's text embeddings measure the relatedness of text strings. Embeddings are commonly used for search, clustering, recommendations, anomaly detection, diversity measurement, and classification. An embedding is a vector (list of floating point numbers) where the distance between two vectors measures their relatedness.\n\nContact Support:\n Name: OpenAI Support\n Email: support@openai.com",
      "type": "text/plain"
    }
  }
