            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "(Required) The audio file object to transcribe, in one of these formats: flac, mp3, mp4, mpeg, mpga, m4a, ogg, wav, or webm. File uploads are limited to 25 MB."
                },
                {
                  "key": "model",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) ID of the model to use. Only whisper-1 and gpt-4o-transcribe are currently available."
                },
                {
                  "key": "language",
                  "value": "<string>",
                  "type": "text",
                  "description": "The language of the input audio. Supplying the input language in ISO-639-1 format will improve accuracy and latency."
                },
                {
                  "key": "prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "An optional text to guide the model's style or continue a previous audio segment. The prompt should match the audio language."
                },
                {
                  "key": "response_format",
                  "value": "json",
                  "type": "text",
                  "description": "The format of the transcript output. Defaults to json. verbose_json includes additional metadata like word-level timestamps. (This can only be one of json,text,srt,verbose_json,vtt)"
                },
                {
                  "key": "temperature",
                  "value": "0",
                  "type": "text",
                  "description": "The sampling temperature, between 0 and 1. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic."
                },
