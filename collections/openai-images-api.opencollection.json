{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAI Assistants Images API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "OpenAI Creates an image given a prompt.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openai.com/v1/images/generations",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "OpenAI Creates an image given a prompt."
        },
        {
          "info": {
            "name": "OpenAI Creates an edited or extended image given an original image and a prompt.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openai.com/v1/images/edits",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "OpenAI Creates an edited or extended image given an original image and a prompt."
        },
        {
          "info": {
            "name": "OpenAI Creates a variation of a given image.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openai.com/v1/images/variations",
            "body": {
              "type": "multipart-form",
              "data": []
            }
          },
          "docs": "OpenAI Creates a variation of a given image."
        }
      ]
    }
  ],
  "bundled": true
}