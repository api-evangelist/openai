{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAI Embeddings API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Embeddings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Openai Create Embeddings",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openai.com/v1/embeddings",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an embedding vector representing the input text. The input can be a single string or an array of strings. Each input must not exceed the max input tokens for the model (8191 tokens for text-embedding-3-small and text-embedding-3-large, 8191 tokens for text-embedding-ada-002)."
        }
      ]
    }
  ],
  "bundled": true
}