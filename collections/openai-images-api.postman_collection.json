          "name": "OpenAI Creates an edited or extended image given an original image and a prompt.",
          "request": {
            "name": "OpenAI Creates an edited or extended image given an original image and a prompt.",
            "description": {},
            "url": {
              "path": [
                "images",
                "edits"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "description": "(Required) The image to edit. Must be a valid PNG file, less than 4MB, and square. If mask is not provided, the image must have transparency which will be used as the mask."
                },
                {
                  "key": "prompt",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) A text description of the desired image(s). The maximum length is 1000 characters for DALL-E 2 and 32000 characters for gpt-image-1."
                },
                {
                  "key": "mask",
                  "type": "file",
                  "description": "An additional image whose fully transparent areas indicate where the image should be edited. Must be a valid PNG file, less than 4MB, and have the same dimensions as image."
                },
                {
                  "key": "model",
                  "value": "dall-e-2",
                  "type": "text",
                  "description": "The model to use for image editing."
                },
                {
                  "key": "n",
                  "value": "1",
                  "type": "text",
                  "description": "The number of images to generate."
                },
                {
                  "key": "size",
                  "value": "1024x1024",
                  "type": "text",
                  "description": "The size of the generated images. (This can only be one of 256x256,512x512,1024x1024,auto)"
                },
                {
                  "key": "response_format",
                  "value": "url",
                  "type": "text",
                  "description": "The format in which the generated images are returned. (This can only be one of url,b64_json)"
                },
                {
                  "key": "user",
                  "value": "<string>",
                  "type": "text",
                  "description": "A unique identifier representing your end-user."
                }
              ]
            }
          },
