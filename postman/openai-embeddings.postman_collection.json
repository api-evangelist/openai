            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"<string>\",\n  \"input\": \"<string>\",\n  \"encoding_format\": \"float\",\n  \"dimensions\": \"<integer>\",\n  \"user\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/embeddings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "embeddings"
              ]
            },
            "description": "Creates an embedding vector representing the input text. The input can be a single string or an array of strings. Each input must not exceed the max input tokens for the model (8191 tokens for text-embedding-3-small and text-embedding-3-large, 8191 tokens for text-embedding-ada-002)."
          },
